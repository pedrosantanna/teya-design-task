{
  "name": "snuffle-prototype",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/ui": "~58.0.26",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react-native": "^1.0.16",
