    "expo": "~58.0.22",
    "expo-blur": "~58.0.5",
    "expo-brightness": "~58.0.2",
    "expo-constants": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.29",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-video": "~58.0.13",
    "expo-web-browser": "~58.0.7",
    "maplibre-gl": "5.24.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-qrcode-svg": "^6.3.50",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-unistyles": "^3.8.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-native": "^5.0.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "tokens": "node scripts/build-tokens.mjs && node scripts/build-map-style.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "typecheck": "tsc --noEmit",
    "check": "npm run -s lint && npm run -s typecheck && npm run -s tokens:check && npm run -s map:check",
    "fonts": "node scripts/fetch-fonts.mjs",
    "postinstall": "node scripts/fetch-fonts.mjs && node scripts/copy-map-web.mjs",
    "export:web": "node scripts/copy-map-web.mjs && SNUFFLE_RELATIVE_WEB=1 expo export --platform web && node scripts/relative-web.mjs",
    "map": "node scripts/build-map-style.mjs",
    "map:check": "node scripts/build-map-style.mjs --check",
    "map:fetch": "node scripts/fetch-map.mjs",
    "map:places": "node scripts/build-places.mjs",
    "map:fallback": "node scripts/render-map-fallback.mjs",
    "synthetic": "npx -y -p playwright@1.58.2 node e2e/run.mjs",
    "synthetic:judge": "node e2e/judge/build-bundle.mjs"
  },
  "private": true
}
