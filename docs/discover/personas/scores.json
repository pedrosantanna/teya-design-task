{
  "_about": "Rubric indicators coded per netnography quote. Edit here, then run scripts/score_personas.py. 'match' is a substring of the quote text used to find it in the docs.",
  "rubric": {
    "x": {
      "label": "Need: browse ↔ mission",
      "mission": {
        "M1": [3, "Names a specific item, shop or service they need"],
        "M2": [3, "States a deadline or time pressure (today, asap, before an event)"],
        "M3": [2, "Checks or asks about availability before or during the trip"],
        "M4": [2, "Switches channel to get it in time (delivery, online, another area)"]
      },
      "browse": {
        "B1": [4, "No specific item: exploring, hunting for finds or bargains"],
        "B2": [3, "Talks about the place, its mix or atmosphere rather than an item"],
        "B3": [3, "Recurring or flexible timing (weekly, Saturdays, special occasions)"]
      }
    },
    "y": {
      "label": "Effort for local: pragmatist ↔ committed",
      "committed": {
        "C1": [3, "States a reason to support local shops (loyalty, community, keeping them open)"],
        "C2": [3, "Keeps buying local despite a cost: higher price, odd hours, a wasted trip"],
        "C3": [2, "Goes out of their way: travels further, calls ahead, tries several shops"],
        "C4": [2, "Values something only independents give: advice, custom cuts, range"]
      },
      "pragmatist": {
        "P1": [4, "Falls back to online, a chain or a supermarket after friction"],
        "P2": [3, "Makes convenience, hours or price the condition for using local"],
        "P3": [3, "Has stopped using the local high street or steers others away"]
      }
    }
  },
